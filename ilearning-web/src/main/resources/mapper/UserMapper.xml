<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.saas.ilearning.mapper.UserMapper">

    <!-- 与 docs/db/ddl.sql 的 user 表结构对齐 -->
    <sql id="baseColumns">
        id, user_name, real_name, password, status, created_at, updated_at
    </sql>

    <select id="getByUsername" resultType="com.saas.ilearning.entity.User">
        SELECT
        <include refid="baseColumns"/>
        FROM `user`
        WHERE `user_name` = #{userName}
        LIMIT 1
    </select>

    <select id="getRoleNamesByUserId" resultType="java.lang.String">
        SELECT r.`role_name`
        FROM `user_role` ur
        JOIN `role` r ON r.`id` = ur.`role_id`
        WHERE ur.`user_id` = #{userId}
        ORDER BY r.`id`
    </select>

    <insert id="insert" parameterType="com.saas.ilearning.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (`user_name`, `real_name`, `password`, `status`)
        VALUES (#{userName}, #{realName}, #{password}, #{status})
    </insert>

    <select id="getRoleIdByName" resultType="java.lang.Long">
        SELECT `id`
        FROM `role`
        WHERE `role_name` = #{roleName}
    </select>

    <insert id="batchInsertUserRoles">
        INSERT INTO `user_role` (`user_id`, `role_id`)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

</mapper>
